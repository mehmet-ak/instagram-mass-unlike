@echo off
rem Builds the Windows executable. Run from the repository root with your virtual environment active.
rem --icon embeds the icon in the .exe file itself (Explorer, taskbar, shortcuts).
rem --add-data bundles the PNG used for the window icon at runtime.

pip install pyinstaller pillow

rem The icon files are generated by assets\make_icon.py; recreate them if they are missing.
if not exist assets\icon.ico python assets\make_icon.py
if not exist assets\icon.png python assets\make_icon.py

pyinstaller --onefile --noconsole --name InstagramMassUnlike-WindowsGUI ^
    --icon assets\icon.ico --add-data "assets\icon.png;assets" unlike_bot.py

echo Done. The executable is in the dist folder.
